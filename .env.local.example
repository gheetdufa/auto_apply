# Copy to .env.local and fill in
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model used for tailoring (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: set to 0 to fill forms but stop before the final Submit click
# AUTO_SUBMIT=0

# Optional: auto-fill the email verification code Greenhouse asks for on submit.
# Use the inbox of the email on your applications (data/contact.json) with a
# Gmail App Password (myaccount.google.com/apppasswords — requires 2FA).
# Unset = the browser window stays open and you type the code yourself.
# EMAIL_IMAP_USER=you@gmail.com
# EMAIL_IMAP_PASS=abcd efgh ijkl mnop
# EMAIL_IMAP_HOST=imap.gmail.com

# Optional: GitHub project sync (pnpm github:sync). Includes private repos when authed.
# Username also comes from data/contact.json "github".
# GITHUB_USERNAME=gheetdufa
# GITHUB_TOKEN=ghp_...   # or rely on `gh auth login` — needed for private repos like auto-trader
